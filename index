<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Smart AI Q&A & Challenge Hub</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    :root {
      --bg-main: #090d16;
      --card-bg: #111827;
      --card-border: rgba(255, 255, 255, 0.14);
      --accent: #3b82f6;
      --accent-soft: rgba(59, 130, 246, 0.16);
      --text-main: #f8fafc;
      --text-muted: #cbd5e1;
      --btn-text: #ffffff;
    }

    body.girl-theme {
      --bg-main: #fff1f5;
      --card-bg: #ffffff;
      --card-border: rgba(236, 72, 153, 0.25);
      --accent: #ec4899;
      --accent-soft: rgba(236, 72, 153, 0.14);
      --text-main: #1f2937;
      --text-muted: #4b5563;
      --btn-text: #ffffff;
    }

    body.boy-theme {
      --bg-main: #071326;
      --card-bg: #0f203d;
      --card-border: rgba(56, 189, 248, 0.3);
      --accent: #0ea5e9;
      --accent-soft: rgba(14, 165, 233, 0.18);
      --text-main: #f0f9ff;
      --text-muted: #bae6fd;
      --btn-text: #ffffff;
    }

    body {
      min-height: 100vh;
      background: var(--bg-main);
      color: var(--text-main);
      transition: background 0.3s ease, color 0.3s ease;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    /* Welcome Card */
    #welcome-screen {
      width: 100%;
      max-width: 440px;
      margin-top: 40px;
      background: #ffffff;
      color: #111827;
      border-radius: 18px;
      padding: 28px 24px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
    }

    #welcome-screen h2 {
      font-size: 24px;
      margin-bottom: 6px;
    }

    #welcome-screen p {
      font-size: 14px;
      color: #4b5563;
      margin-bottom: 18px;
    }

    .input-field {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1.5px solid #d1d5db;
      font-size: 15px;
      margin-bottom: 14px;
      outline: none;
      background: #f9fafb;
      color: #111827;
    }

    .input-field:focus {
      border-color: var(--accent);
    }

    .zone-btn {
      width: 100%;
      padding: 13px;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      margin-bottom: 10px;
      color: #ffffff;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .zone-btn:hover {
      opacity: 0.94;
      transform: translateY(-1px);
    }

    .btn-girl {
      background: #e11d48;
    }

    .btn-boy {
      background: #0284c7;
    }

    .auto-hint {
      font-size: 12.5px;
      color: #6b7280;
      text-align: center;
      margin-top: 4px;
    }

    /* Main Hub */
    #hub-container {
      display: none;
      width: 100%;
      max-width: 920px;
      background: var(--card-bg);
      border: 1.5px solid var(--card-border);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
    }

    .hub-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--card-border);
      margin-bottom: 18px;
    }

    .hub-title {
      font-size: 22px;
      font-weight: 800;
      color: var(--accent);
    }

    .hub-sub {
      font-size: 13.5px;
      color: var(--text-muted);
      margin-top: 3px;
    }

    .nav-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }

    .nav-btn {
      padding: 10px 16px;
      border-radius: 10px;
      border: 1px solid var(--card-border);
      background: transparent;
      color: var(--text-main);
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
    }

    .nav-btn.active {
      background: var(--accent);
      color: var(--btn-text);
      border-color: var(--accent);
    }

    .section {
      display: none;
    }

    .section.active {
      display: block;
    }

    .box {
      border: 1px solid var(--card-border);
      background: var(--accent-soft);
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 16px;
    }

    .box h3 {
      margin-bottom: 10px;
      font-size: 17px;
      color: var(--text-main);
    }

    .box p {
      color: var(--text-muted);
      font-size: 14px;
      line-height: 1.55;
    }

    textarea.input-field {
      resize: vertical;
      min-height: 75px;
    }

    .action-btn {
      padding: 11px 18px;
      border: none;
      border-radius: 10px;
      background: var(--accent);
      color: var(--btn-text);
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
    }

    .answer-card {
      margin-top: 14px;
      padding: 16px;
      border-radius: 12px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
    }

    .answer-card h4 {
      color: var(--accent);
      margin-bottom: 8px;
      font-size: 16px;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin-top: 10px;
    }

    .relax-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 16px;
    }

    .relax-card h4 {
      color: var(--accent);
      margin-bottom: 8px;
      font-size: 15px;
    }

    .user-pill {
      display: inline-block;
      margin-top: 12px;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 600;
      background: var(--accent-soft);
      color: var(--text-main);
      border: 1px solid var(--card-border);
    }
  </style>
</head>
<body>

  <!-- WELCOME SCREEN -->
  <div id="welcome-screen">
    <h2>👋 Welcome Student!</h2>
    <p>Enter your name and choose your zone:</p>

    <input
      type="text"
      id="student-name"
      class="input-field"
      placeholder="Enter your name..."
      oninput="detectNameHint()"
    />

    <button type="button" class="zone-btn btn-girl" onclick="enterHub('girl')">
      🌸 Girl (Pink)
    </button>
    <button type="button" class="zone-btn btn-boy" onclick="enterHub('boy')">
      🌊 Boy (Blue)
    </button>

    <p class="auto-hint" id="name-hint">Tip: Type your name — matching zone is highlighted automatically.</p>
  </div>

  <!-- MAIN PORTAL HUB -->
  <div id="hub-container">
    <div class="hub-header">
      <div>
        <div class="hub-title" id="hub-heading">🌸 Pink Smart AI Q&amp;A &amp; Challenge Hub</div>
        <div class="hub-sub" id="hub-subtitle">Welcome, Student! Explore your zone.</div>
      </div>
      <span class="user-pill" id="active-badge">Saba Anfaal • Girl Zone</span>
    </div>

    <div class="nav-row">
      <button type="button" class="nav-btn active" onclick="showSection('qa-sec', this)">🤖 AI Q&amp;A Portal</button>
      <button type="button" class="nav-btn" onclick="showSection('quiz-sec', this)">🎯 Challenge Quiz</button>
      <button type="button" class="nav-btn" onclick="showSection('story-sec', this)">📖 Share Story</button>
      <button type="button" class="nav-btn" onclick="showSection('relax-sec', this)">☕ Relaxation Cards</button>
      <button type="button" class="nav-btn" onclick="switchProfile()">🔄 Switch Profile</button>
    </div>

    <!-- 1. AI Q&A PORTAL -->
    <div id="qa-sec" class="section active">
      <div class="box">
        <h3>✨ Ask Question &amp; Generate Fun AI Answer</h3>
        <input
          type="text"
          id="qa-input"
          class="input-field"
          placeholder="e.g. Introduction to Data Science, Python, C++..."
        />
        <button type="button" class="action-btn" onclick="generateAnswer()">
          Generate Magical AI Answer
        </button>
      </div>

      <div id="qa-results">
        <div class="answer-card">
          <h4>💡 Introduction to Data Science</h4>
          <p><strong>1. Quick Summary:</strong> Data Science combines statistics, programming, and domain knowledge to turn raw data into useful insights.</p>
          <p style="margin-top:6px;"><strong>2. Key Idea:</strong> Collecting data, cleaning it, exploring patterns, and building models to make smart decisions.</p>
        </div>
      </div>
    </div>

    <!-- 2. CHALLENGE QUIZ -->
    <div id="quiz-sec" class="section">
      <div class="box">
        <h3>🏆 Student Challenge Quiz Arena</h3>
        <p style="margin-bottom:12px;"><strong>Question of the Day:</strong> What is Data Science?</p>
        <p style="margin-bottom:14px;">A blend of mathematics, algorithms, and technology to extract insights.</p>
        <button type="button" class="action-btn" onclick="answerQuiz(true)">True / Yes</button>
        <button type="button" class="action-btn" style="margin-left:8px; opacity:0.85;" onclick="answerQuiz(false)">False / No</button>
        <p id="quiz-result" style="margin-top:12px; font-weight:700;"></p>
      </div>
    </div>

    <!-- 3. SHARE STORY -->
    <div id="story-sec" class="section">
      <div class="box">
        <h3>✍️ Share Your Student Story</h3>
        <input type="text" id="story-title" class="input-field" placeholder="Story Title (e.g. My Study Routine Experience)" />
        <textarea id="story-body" class="input-field" placeholder="Share your thoughts or experiences here..."></textarea>
        <button type="button" class="action-btn" onclick="publishStory()">Publish Story</button>
      </div>
      <div id="story-list"></div>
    </div>

    <!-- 4. RELAXATION CARDS -->
    <div id="relax-sec" class="section">
      <div class="box">
        <h3>🌿 Relaxation &amp; Break Cards</h3>
        <p>Take a calm pause between study blocks and refresh your mind.</p>
        <div class="cards-grid">
          <div class="relax-card">
            <h4>☕ Chai / Coffee Break</h4>
            <p>Step away from screens for 5 minutes, sip warm tea or coffee, and rest your eyes.</p>
          </div>
          <div class="relax-card">
            <h4>🌬️ Deep Breath Reset</h4>
            <p>Inhale slowly for 4 seconds, hold for 4 seconds, and exhale gently for 4 seconds.</p>
          </div>
          <div class="relax-card">
            <h4>🎧 Light Mood &amp; Stretch</h4>
            <p>Roll your shoulders back, stretch your neck softly, and listen to a calm tune.</p>
          </div>
          <div class="relax-card">
            <h4>✨ Gentle Reminder</h4>
            <p>One steady step at a time is enough. You don't have to rush everything at once.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const femaleNames = ['saba', 'anfaal', 'ayesha', 'fatima', 'zainab', 'hira', 'maryam', 'sana', 'amina', 'maham', 'iqra', 'nimra'];
    const maleNames = ['ali', 'ahmed', 'muhammad', 'usman', 'bilal', 'hamza', 'umer', 'abdullah', 'hassan', 'zaid', 'daniyal'];

    let currentName = 'Saba Anfaal';
    let currentGender = 'girl';

    function detectGenderFromName(name) {
      const clean = name.trim().toLowerCase();
      if (!clean) return null;
      const firstWord = clean.split(/\s+/)[0];
      if (femaleNames.includes(firstWord) || clean.endsWith('a') || clean.endsWith('i') || clean.endsWith('ah')) {
        return 'girl';
      }
      if (maleNames.includes(firstWord)) {
        return 'boy';
      }
      return null;
    }

    function detectNameHint() {
      const nameVal = document.getElementById('student-name').value;
      const detected = detectGenderFromName(nameVal);
      const hint = document.getElementById('name-hint');
      if (detected === 'girl') {
        hint.textContent = 'Detected name vibe: Girl (Pink) — tap Girl (Pink) or Boy (Blue) to enter.';
      } else if (detected === 'boy') {
        hint.textContent = 'Detected name vibe: Boy (Blue) — tap Boy (Blue) or Girl (Pink) to enter.';
      } else {
        hint.textContent = 'Tip: Type your name — choose Girl (Pink) or Boy (Blue) to open your zone.';
      }
    }

    function enterHub(chosenGender) {
      const inputName = document.getElementById('student-name').value.trim();
      const autoGender = detectGenderFromName(inputName);
      currentGender = chosenGender || autoGender || 'girl';
      currentName = inputName || (currentGender === 'girl' ? 'Saba Anfaal' : 'Student');

      document.body.classList.remove('girl-theme', 'boy-theme');
      if (currentGender === 'girl') {
        document.body.classList.add('girl-theme');
        document.getElementById('hub-heading').textContent = '🌸 Pink Smart AI Q&A & Challenge Hub';
        document.getElementById('active-badge').textContent = `${currentName} • Girl Zone`;
      } else {
        document.body.classList.add('boy-theme');
        document.getElementById('hub-heading').textContent = '🌊 Blue Smart AI Q&A & Challenge Hub';
        document.getElementById('active-badge').textContent = `${currentName} • Boy Zone`;
      }

      document.getElementById('hub-subtitle').textContent = `Welcome, ${currentName}! Explore your zone.`;
      document.getElementById('welcome-screen').style.display = 'none';
      document.getElementById('hub-container').style.display = 'block';
    }

    function switchProfile() {
      document.getElementById('hub-container').style.display = 'none';
      document.getElementById('welcome-screen').style.display = 'block';
    }

    function showSection(sectionId, btn) {
      document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(sectionId).classList.add('active');
      if (btn) btn.classList.add('active');
    }

    function generateAnswer() {
      const q = document.getElementById('qa-input').value.trim();
      if (!q) return;

      const card = document.createElement('div');
      card.className = 'answer-card';
      card.innerHTML = `
        <h4>💡 ${q}</h4>
        <p><strong>1. Quick Summary:</strong> Here is a clear and structured overview of <strong>${q}</strong> so you can revise quickly.</p>
        <p style="margin-top:6px;"><strong>2. Key Points:</strong> Focus on core definitions, practical examples, and how it connects to your main topic.</p>
      `;
      document.getElementById('qa-results').prepend(card);
      document.getElementById('qa-input').value = '';
    }

    function answerQuiz(isTrue) {
      const res = document.getElementById('quiz-result');
      if (isTrue) {
        res.textContent = '✅ Spot on! Data Science blends math, stats, programming, and domain knowledge.';
      } else {
        res.textContent = '❌ Not quite — that statement is True!';
      }
    }

    function publishStory() {
      const title = document.getElementById('story-title').value.trim();
      const body = document.getElementById('story-body').value.trim();
      if (!title || !body) return;

      const item = document.createElement('div');
      item.className = 'answer-card';
      item.innerHTML = `
        <h4>📖 ${title}</h4>
        <p>${body}</p>
        <p style="margin-top:8px; font-size:12px; opacity:0.8;">Posted by ${currentName}</p>
      `;
      document.getElementById('story-list').prepend(item);
      document.getElementById('story-title').value = '';
      document.getElementById('story-body').value = '';
    }
  </script>
</body>
</html>
